---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BootScreen from '../components/BootScreen.astro';
import { site } from '../config';

interface Props {
  /** Page title; " · PennyLog" is appended. Leave out on the home page to get `site.title`. */
  title?: string;
  description?: string;
  /** Short name for the breadcrumb trail in structured data; defaults to `title`. */
  crumb?: string;
  /** Extra JSON-LD objects for this page (see docs/seo.md). */
  schema?: Record<string, unknown>[];
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const { title, description = site.description, crumb = title, schema = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
// One URL per page: no trailing slash (vercel.json redirects the slashed form here).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).href;

// Every page but the home page gets a Home › Page breadcrumb.
const ld = [...schema];
if (path !== '/' && canonical && crumb && !noindex) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
    ],
  });
}
---

<!doctype html>
<html lang="en-IN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0C0D" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F4F6F5" media="(prefers-color-scheme: light)" />
    <meta name="application-name" content={site.name} />
    <meta name="author" content={site.developer} />
    <meta name="google-play-app" content={`app-id=${site.appId}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogAlt} />
    <meta name="generator" content={Astro.generator} />
    {ld.map((obj) => <script type="application/ld+json" is:inline set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
    <script is:inline>
      // Pick the theme before first paint: saved choice, else the system's, else dark.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('pl-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.dataset.theme = t;
        // First load in this tab gets the intro screen (add ?intro to any URL to see it again).
        // Skipped for reduced motion; without JS it never appears.
        var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = sessionStorage.getItem('pl-booted') === '1'; } catch (e) {}
        if (/[?&]intro(=|&|$)/.test(location.search)) seen = false;
        if (!reduced && !seen) {
          d.classList.add('boot');
          window.plBootAt = performance.now(); // when the intro starts painting
        }
      })();
    </script>
  </head>
  <body class="flex flex-col">
    <BootScreen />
    <a
      href="#main"
      class="sr-only z-50 rounded-xl bg-brand px-4 py-3 font-semibold text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex flex-col">
      <slot />
    </main>
    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';
      // While the intro screen is up, wait for it to leave so reveals and count-ups play in view.
      if (document.documentElement.classList.contains('boot')) addEventListener('pl:booted', () => initReveal(), { once: true });
      else initReveal();
    </script>
  </body>
</html>
