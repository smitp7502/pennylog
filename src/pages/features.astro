---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import PhoneShot from '../components/PhoneShot.astro';

type Feature = { icon: IconName; tile?: string; title: string; body: string; appOnly?: boolean };
type Group = {
  n: string;
  title: string;
  lead: string;
  link?: { href: string; label: string; button?: boolean };
  shot: { screen: string; alt: string };
  accent: string; // CSS colour token for the stage glow
  items: Feature[];
};

const groups: Group[] = [
  {
    n: '01 · Track',
    accent: 'var(--brand)',
    shot: { screen: 'add-record', alt: 'Add record screen: an expense of ₹1,240 from HDFC Bank for Groceries' },
    title: 'Log money in and out.',
    lead: 'Built for the thirty seconds after you pay for something.',
    items: [
      { icon: 'out', tile: 'bg-expense-soft text-expense', title: 'Expense, income and transfer', body: 'Three record types with clear signs and colours, so +₹ and −₹ are never confused.' },
      { icon: 'bank', tile: 'bg-cat-yellow/16 text-cat-yellow', title: 'Accounts', body: 'Cash, banks and wallets each hold their own balance. Add as many as you use.' },
      { icon: 'shapes', tile: 'bg-cat-orange/16 text-cat-orange', title: 'Your own categories', body: 'Start with the built-in set, then add, rename and recolour categories for income and expense.' },
      { icon: 'repeat', tile: 'bg-cat-violet/16 text-cat-violet', title: 'Recurring records', body: 'Rent, salary and subscriptions repeat on the schedule you set. What is due today shows on the dashboard.' },
      { icon: 'tag', tile: 'bg-cat-pink/16 text-cat-pink', title: 'People tags', body: 'Mark who a record was for — Mom, your brother, a friend — and filter by person later.' },
      { icon: 'bell', tile: 'bg-warning-soft text-warning', title: 'Daily reminder', body: 'One gentle nudge at the time you choose, so the day’s spends do not slip away.' },
    ],
  },
  {
    n: '02 · Understand',
    accent: 'var(--cat-sky)',
    shot: { screen: 'statistics', alt: 'Statistics screen: October spending by category in a donut chart' },
    title: 'See where it went.',
    lead: 'The amount is always the biggest thing on the screen.',
    items: [
      { icon: 'home', tile: 'bg-brand-soft text-brand', title: 'Monthly dashboard', body: 'Balance, income and expense for the month, with every record grouped by day underneath.' },
      { icon: 'eyeOff', title: 'Hide your balance', body: 'One tap masks the balance, income and expense totals when someone is looking over your shoulder.' },
      { icon: 'pie', tile: 'bg-cat-sky/16 text-cat-sky', title: 'Spending by category', body: 'See which categories take the biggest share, for expense or income.' },
      { icon: 'calendar', tile: 'bg-expense-soft text-expense', title: 'Daily spending calendar', body: 'A month laid out day by day, with the heavy days standing out and a daily average on top.' },
      { icon: 'stats', title: 'Longer periods', body: 'Switch the trend to three months, six months or a full year to see the bigger pattern.' },
      { icon: 'wallet', title: 'Stats per account', body: 'Check how much moved through each account without scrolling the whole list.' },
    ],
  },
  {
    n: '03 · Plan',
    accent: 'var(--warning)',
    shot: { screen: 'budgets', alt: 'Budget screen: ₹5,500 left of ₹21,500 with a progress bar per category' },
    title: 'Set limits that hold.',
    lead: 'A budget only helps if it warns you before the money is gone.',
    items: [
      { icon: 'target', tile: 'bg-brand-soft text-brand', title: 'Budgets per category', body: 'Set a monthly limit for the categories that matter and watch what is left.' },
      { icon: 'warn', tile: 'bg-warning-soft text-warning', title: 'Warnings in plain words', body: '“Almost used”, “Limit reached”, “Over budget” — the status is written out, not just coloured.' },
      { icon: 'copy', title: 'Budget templates', body: 'Save a month’s limits as a template and apply it to the next month in one tap.' },
      { icon: 'clock', title: 'Past budgets', body: 'Look back at earlier months to see whether you stayed inside the plan.' },
    ],
  },
  {
    n: '04 · Share',
    accent: 'var(--cat-violet)',
    shot: { screen: 'who-pays-whom', alt: 'Who pays whom for the Goa Trip: three payments settle everyone' },
    title: 'Split with friends.',
    lead: 'For trips, dinners and flat expenses. Everyone sees the same numbers.',
    link: { href: '/split', label: 'Try it in your browser', button: true },
    items: [
      { icon: 'users', tile: 'bg-cat-sky/16 text-cat-sky', title: 'Groups and people', body: 'Create a group, add people once, and reuse them in the next group.' },
      { icon: 'swap', tile: 'bg-brand-soft text-brand', title: 'Who pays whom', body: 'PennyLog works out the fewest payments that settle the whole group.' },
      { icon: 'layers', tile: 'bg-cat-violet/16 text-cat-violet', title: 'Sub-groups', body: 'When only some of the group shared a cost, split it among just those people.' },
      { icon: 'share', tile: 'bg-cat-orange/16 text-cat-orange', title: 'Shareable summary', body: 'Send one clean image of the split to the group chat. Friends do not need the app to read it.' },
      { icon: 'qr', title: 'UPI QR for each payment', appOnly: true, body: 'Show or share a QR with the amount filled in. The payment itself happens in your friend’s UPI app.' },
      { icon: 'checkCircle', title: 'Mark a group settled', body: 'Close a group when everyone has paid, and reopen it if something was missed.' },
    ],
  },
  {
    n: '05 · Keep',
    accent: 'var(--transfer)',
    shot: { screen: 'backup', alt: 'Backup and restore screen connected to Google Drive' },
    title: 'Your data, your phone.',
    lead: 'PennyLog works offline first. A backup goes to your own Google Drive only if you turn it on.',
    link: { href: '/privacy', label: 'Read the privacy policy' },
    items: [
      { icon: 'phone', tile: 'bg-brand-soft text-brand', title: 'Offline first', body: 'Records are saved on the device. No signal, no problem.' },
      { icon: 'cloud', tile: 'bg-transfer-soft text-transfer', title: 'Google Drive backup and restore', body: 'Back up now or on a schedule, and bring everything back on a new phone.' },
      { icon: 'file', tile: 'bg-cat-orange/16 text-cat-orange', title: 'PDF and Excel export', body: 'Export any period as a PDF report you can save or send, or as an Excel sheet for your own formulas.' },
      { icon: 'moon', title: 'Dark and light themes', body: 'Dark by default and easy on the eyes at night, with a light theme that mirrors it.' },
      { icon: 'globe', title: 'Your currency', body: 'Pick your currency when you start and change it later in preferences.' },
      { icon: 'trash', tile: 'bg-expense-soft text-expense', title: 'Delete and reset', body: 'Wipe your records whenever you like. The app tells you exactly what will go before it does.' },
    ],
  },
];
---

<Base title="Features" description="Everything PennyLog does: records, accounts, budgets, statistics, split expenses, recurring records and Google Drive backup.">
  <PageHero eyebrow="Features" lead="A money app should be quick to open and quick to close. Here is the full list of what is inside, grouped by what you are trying to do.">
    Everything PennyLog does, <span class="text-brand">nothing it doesn’t.</span>
  </PageHero>

  {
    groups.map((g, gi) => (
      <section class="wrap">
        <div class="flex flex-col gap-8 border-t border-line py-14 md:gap-10 md:py-20">
          <!-- Heading row -->
          <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4" data-reveal>
            <div class="flex max-w-[640px] flex-col gap-3">
              <span class="text-sm font-semibold text-brand">{g.n}</span>
              <h2 class="m-0 font-display text-[clamp(28px,3.4vw,40px)] leading-[1.1] font-bold tracking-[-0.025em] text-balance">{g.title}</h2>
              <p class="lead">{g.lead}</p>
            </div>
            {g.link &&
              (g.link.button ? (
                <a href={g.link.href} class="btn btn-o">
                  {g.link.label}
                  <Icon name="arrow" size={18} class="arrow" />
                </a>
              ) : (
                <a href={g.link.href} class="text-[15px] font-semibold">
                  {g.link.label}
                </a>
              ))}
          </div>

          <div
            class:list={[
              'grid gap-4 lg:gap-6',
              gi % 2 === 0 ? 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]' : 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]',
            ]}
          >
            <!-- Stage: the top of the real screen, rising out of a tinted panel -->
            <div
              class:list={[
                'stage relative h-[clamp(300px,90vw,360px)] overflow-hidden rounded-sheet border border-line lg:h-auto lg:min-h-[420px]',
                gi % 2 === 1 && 'lg:order-2',
              ]}
              style={`--accent:${g.accent}`}
              data-reveal="scale"
            >
              <div class="phone-rise absolute top-8 left-1/2 w-[min(64%,240px)] -translate-x-1/2 lg:top-10 lg:w-[min(60%,270px)]">
                <PhoneShot screen={g.shot.screen} alt={g.shot.alt} sizes="(min-width: 1024px) 270px, 240px" />
              </div>
              <div aria-hidden="true" class="stage-fade pointer-events-none absolute inset-x-0 bottom-0 h-28"></div>
            </div>

            <!-- Features -->
            <div class="grid content-start gap-3 sm:grid-cols-2 lg:auto-rows-fr lg:content-stretch">
              {g.items.map((f, i) => (
                <div
                  class="group flex items-start gap-3.5 rounded-card border border-line bg-surface p-4 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-line-strong sm:p-[18px]"
                  data-reveal
                  style={`--i:${i % 2}`}
                >
                  <span class:list={['tile transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6', f.tile ?? 'bg-raised text-muted']}>
                    <Icon name={f.icon} />
                  </span>
                  <div>
                    <h3 class="m-0 mb-1 text-base leading-[22px] font-semibold">
                      {f.title}
                      {f.appOnly && (
                        <span class="ml-2 inline-flex h-[22px] items-center rounded-lg bg-brand-soft px-2 align-[2px] text-[11px] font-semibold whitespace-nowrap text-brand">
                          App only
                        </span>
                      )}
                    </h3>
                    <p class="m-0 text-sm leading-[21px] text-muted">{f.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand text="All of this is in the app today. Install it and log your first spend in under a minute." />
</Base>

<style>
  /* Tinted panel behind each section's screenshot; the glow takes the section's accent colour. */
  .stage {
    background:
      radial-gradient(70% 55% at 50% 12%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 72%),
      radial-gradient(50% 40% at 50% 100%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
      var(--surface);
  }
  /* The screen fades into the panel instead of ending in a hard crop. */
  .stage-fade { background: linear-gradient(to top, var(--surface) 8%, transparent); }
  /* The phone rises into place as the panel scrolls into view. */
  :global(.js) [data-reveal] .phone-rise {
    transform: translateY(56px);
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }
  :global(.js) [data-reveal].is-in .phone-rise { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] .phone-rise { transform: none; }
  }
</style>
