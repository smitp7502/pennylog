---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config';

// Answers may contain trusted inline HTML (links), so they are rendered with set:html.
const sections: { title: string; qs: [string, string][] }[] = [
  {
    title: 'Getting started',
    qs: [
      ['Do I need to create an account?', 'No. Install the app, pick your currency and start logging. You only sign in with Google if you choose to turn on backup.'],
      ['Does it work without internet?', 'Yes. Your records are saved on your phone, so adding, editing, budgets and statistics all work with no signal. You need a connection only for Google Drive backup and restore.'],
      ['Where do I get PennyLog?', `PennyLog is on <a href="${site.playUrl}" rel="noopener">Google Play</a> for Android phones.`],
      ['Can I use a currency other than rupees?', 'Yes. You choose a currency when you first open the app and can change it later in preferences.'],
    ],
  },
  {
    title: 'Records and budgets',
    qs: [
      ['What can I record?', 'Expenses, income and transfers between your own accounts. Each record has an amount, a category and the account it belongs to. You can also tag who it was for.'],
      ['Can I keep cash, bank and wallet money separate?', 'Yes. Add an account for each place your money sits. Every account keeps its own balance, and moving money between two of them is a transfer, not an expense.'],
      ['How do recurring records work?', 'Set a record such as rent, salary or a subscription to repeat on a schedule. PennyLog can add it for you automatically, or ask first — what is due today shows on the dashboard so nothing regular is missed.'],
      ['How does a budget warn me?', 'Give a category a monthly limit. As you spend, its status changes in words: on track, almost used, limit reached or over budget. You can save a month’s limits as a template and reuse them.'],
      ['Can I get my records out of the app?', 'Yes. Export any period as a PDF report that you can save, print or send, or as an Excel spreadsheet with one row per record.'],
    ],
  },
  {
    title: 'Split expenses',
    qs: [
      ['Do my friends need PennyLog to see a split?', 'No. You share a summary that shows who paid and who pays whom. Anyone can read it in the group chat.'],
      ['Does PennyLog move the money?', 'No. PennyLog only does the maths. Your friends pay each other however they like, and you mark the group settled when everyone is done.'],
      ['How is the split tool on this site different from the app?', 'The <a href="/split">split tool here</a> is for a quick one-off: it works out the payments and gives you a summary to share, but it saves nothing. The app keeps your groups and people, supports sub-groups and adds a UPI QR to each payment.'],
      ['What if only some people shared a cost?', 'The split tool on this site shares every expense equally among everyone, to keep it quick. In the app, make a sub-group for the people who shared a cost and it is split among just them.'],
    ],
  },
  {
    title: 'Your data',
    qs: [
      ['Where is my data stored?', 'On your phone. If you turn on backup, a copy also goes to your own Google Drive. The <a href="/privacy">privacy policy</a> has the details.'],
      ['How do I move to a new phone?', 'Back up on the old phone from Backup &amp; restore. On the new phone, install PennyLog, sign in with the same Google account and restore.'],
      ['Can someone see my amounts over my shoulder?', 'Tap the eye on the balance card at the top of the dashboard to hide your balance, income and expense totals until you tap it again. Amounts in the record list stay visible.'],
      ['How do I delete everything?', 'Open Delete &amp; reset in settings. The app tells you exactly what will be removed before it does it. A backup in Google Drive stays there until you remove it from your Drive.'],
    ],
  },
];
---

<Base title="FAQ" description="Answers about PennyLog: accounts, offline use, budgets, recurring records, split expenses, backup and your data.">
  <PageHero eyebrow="FAQ" lead="The things people ask before they install PennyLog, and a few they ask after.">
    Questions, <span class="text-brand">answered plainly.</span>
  </PageHero>

  {
    sections.map((s, si) => (
      <section class="wrap">
        <div class="flex flex-wrap gap-x-16 gap-y-5 border-t border-line py-12">
          <h2 class="m-0 max-w-[340px] min-w-0 flex-[1_1_240px] font-display text-[26px] leading-8 font-bold tracking-[-0.015em] md:sticky md:top-28 md:self-start" data-reveal="left">
            {s.title}
          </h2>
          <div class="flex min-w-0 flex-[3_1_560px] flex-col gap-2">
            {s.qs.map(([q, a], i) => (
              <details
                class="faq rounded-card border border-line bg-surface transition-colors duration-200 hover:border-line-strong open:border-line-strong"
                open={si === 0 && i === 0}
                data-reveal
                style={`--i:${i}`}
              >
                <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 rounded-card px-5 py-3.5 text-[17px] leading-6 font-semibold">
                  <span class="min-w-0 flex-1">{q}</span>
                  <Icon name="plus" class="text-subtle" />
                </summary>
                <p class="m-0 max-w-[680px] px-5 pb-5 text-[15px] leading-6 text-pretty text-muted" set:html={a} />
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="wrap pt-4 pb-28">
    <div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-6 rounded-sheet border border-line bg-surface p-[clamp(24px,4vw,48px)]" data-reveal="scale">
      <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-2">
        <h2 class="m-0 font-display text-[clamp(26px,3vw,36px)] leading-[1.1] font-bold tracking-[-0.02em]">Still have a question?</h2>
        <p class="m-0 text-[17px] leading-[27px] text-muted">Write to us and a person will reply.</p>
      </div>
      <a href={`mailto:${site.supportEmail}`} class="btn btn-o"><Icon name="mail" size={18} />{site.supportEmail}</a>
    </div>
  </section>
</Base>
