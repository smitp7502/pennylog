---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import PlayButton from '../components/PlayButton.astro';
import HikeStory from '../components/HikeStory.astro';
import PhoneShot from '../components/PhoneShot.astro';
import { splitToolSchema } from '../schema';

const panel = 'flex flex-col gap-4 rounded-card border border-line bg-surface p-4 sm:p-5';
const step = 'flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-soft text-[13px] font-bold text-brand';
const h2 = 'm-0 font-display text-xl leading-[26px] font-semibold tracking-[-0.01em]';
const lab = 'text-[13px] leading-[18px] font-medium text-muted';
// 16px text keeps iPhones from zooming in when a field is tapped.
const inp =
  'h-12 w-full min-w-0 rounded-xl border border-line-strong bg-raised px-3.5 text-base text-ink transition-[border-color,box-shadow] placeholder:text-subtle focus:border-brand focus:shadow-[0_0_0_3px_var(--glow)] focus:outline-none disabled:opacity-50';

const appShots = [
  { screen: 'split-group', title: 'Groups that remember', body: 'Who paid, each share, and who gets back or owes.', alt: 'Goa Trip group: ₹16,000 spent by four people, with each person’s paid amount and balance' },
  { screen: 'upi-qr', title: 'Pay with a scan', body: 'A UPI QR for each payment, amount filled in.', alt: 'UPI QR code for Rahul paying ₹1,250' },
  { screen: 'split-summary', title: 'One image for the chat', body: 'Save or share the whole split as a picture.', alt: 'Split summary image preview with who paid and who pays whom' },
];

const inApp = [
  ['Groups are saved', 'Keep a trip open for days and add expenses as they happen.'],
  ['People are reused', 'Add a friend once and pick them again for the next group.'],
  ['Sub-groups', 'Split a cost among just the few people who shared it.'],
  ['Settle and reopen', 'Mark a group settled when everyone has paid. Reopen it if something was missed.'],
];

const howTo = [
  ['Add everyone who is splitting', 'Type the names once, separated by commas. The group can be two flatmates or a whole trip.'],
  ['Add each expense and who paid it', 'Hotel, cab, dinner: enter the amount and pick the person who paid. Every expense is shared equally.'],
  ['Settle up with the fewest payments', 'PennyLog nets out what each person paid against their share, then pairs the people who owe with the people who are owed, so the group settles in as few payments as possible.'],
];

const useCases = [
  { icon: 'globe', tile: 'bg-cat-sky/16 text-cat-sky', title: 'Trips and travel', body: 'Split hotel, fuel, tickets and food on a Goa trip or a weekend trek, then settle once you are home.' },
  { icon: 'home', tile: 'bg-brand-soft text-brand', title: 'Flatmates and roommates', body: 'Share rent, electricity, Wi-Fi and groceries without keeping a running tab in your head.' },
  { icon: 'food', tile: 'bg-cat-orange/16 text-cat-orange', title: 'Dinners and nights out', body: 'One person pays the bill, everyone pays them back. Send the summary before the cab arrives.' },
  { icon: 'users', tile: 'bg-cat-violet/16 text-cat-violet', title: 'Gifts and office lunches', body: 'Chip in for a birthday gift or a team lunch and see exactly who still owes how much.' },
] as const;
---

<Base
  title="Split Expenses Calculator: Split Bills with Friends"
  crumb="Split expenses"
  description="Free online bill splitter: add who paid what and see who owes whom, with the fewest payments to settle up. For trips, flatmates and dinners. No sign-up."
  schema={[splitToolSchema(Astro.site!)]}
>
  <PageHero
    eyebrow="Split expenses · works right here"
    lead="Add the people, add what each one paid, and PennyLog works out the fewest payments that settle everyone. Then send the summary to the group chat."
  >
    Split expenses with friends, <span class="text-brand">sorted in a minute.</span>
  </PageHero>

  <section class="wrap flex flex-wrap items-start gap-4 pb-28 sm:gap-6 lg:pb-24" data-split>
    <!-- Inputs -->
    <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-4">
      <div class={panel} data-reveal>
        <div class="flex items-center gap-3">
          <span class={step}>1</span><h2 class={h2}>Who’s splitting?</h2>
          <span class:list={[lab, 'ml-auto']} id="people-count"></span>
        </div>
        <ul id="people" class="m-0 flex flex-wrap gap-2 p-0"></ul>
        <form id="person-form" class="flex gap-2">
          <label for="pname" class="sr-only">Names</label>
          <input id="pname" class={inp} type="text" maxlength="120" placeholder="Add names, e.g. Riya, Kabir" autocomplete="off" enterkeyhint="done" />
          <button class="btn btn-o h-12 shrink-0 px-4" type="submit"><Icon name="plus" size={18} strokeWidth={2.25} /><span class="max-[379px]:sr-only">Add</span></button>
        </form>
        <p class:list={[lab, 'm-0 -mt-2 text-expense empty:hidden']} id="person-note" role="status"></p>
        <div class="flex flex-col gap-1.5">
          <label class={lab} for="grp">Group name <span class="text-subtle">(optional)</span></label>
          <input id="grp" class={inp} type="text" maxlength="32" placeholder="Trip to Udaipur" autocomplete="off" />
        </div>
      </div>

      <div class={panel} data-reveal style="--i:1">
        <div class="flex items-center gap-3"><span class={step}>2</span><h2 class={h2}>Add an expense</h2></div>
        <form id="expense-form" class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="flex min-w-0 flex-col gap-1.5">
              <label class={lab} for="eamt">Amount</label>
              <div class="relative">
                <span class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-base font-semibold text-muted">₹</span>
                <input id="eamt" class:list={[inp, 'num pl-8 text-lg font-semibold']} type="text" inputmode="decimal" placeholder="0" autocomplete="off" enterkeyhint="next" />
              </div>
            </div>
            <div class="flex min-w-0 flex-col gap-1.5">
              <label class={lab} for="payer">Paid by</label>
              <div class="relative">
                <select id="payer" class:list={[inp, 'appearance-none pr-9 font-semibold']}></select>
                <svg class="ic pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-muted" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class={lab} for="etitle">What for? <span class="text-subtle">(optional)</span></label>
            <input id="etitle" class={inp} type="text" maxlength="32" placeholder="Dinner, cab, tickets…" autocomplete="off" enterkeyhint="done" />
          </div>
          <button id="add-expense" class="btn btn-p w-full" type="submit"><Icon name="plus" size={18} strokeWidth={2.25} />Add expense</button>
          <p class:list={[lab, 'num m-0 text-center text-subtle']}><span id="form-hint" class="empty:hidden"></span><span id="each"></span></p>
        </form>

        <div id="expense-list" class="flex flex-col border-t border-line pt-3">
          <div class="flex items-baseline justify-between gap-3 pb-1">
            <span class="ov text-[11px]">Expenses</span>
            <span class:list={[lab, 'num']} id="expense-total"></span>
          </div>
          <div id="expense-rows" class="flex flex-col"></div>
        </div>
      </div>

      <p class:list={[lab, 'm-0 px-1 text-subtle']}>This page keeps nothing. Close the tab and the group is gone. In the app, groups are saved on your phone.</p>
    </div>

    <!-- Results -->
    <div id="result-zone" class="flex min-w-0 flex-[1_1_360px] scroll-mt-20 flex-col gap-4 lg:sticky lg:top-24">
      <div id="result" class:list={[panel, 'scroll-mt-20 md:scroll-mt-24']} aria-live="polite" data-reveal>
        <div class="flex flex-col gap-1">
          <span class="ov text-[11px] [overflow-wrap:anywhere]" id="group-upper"></span>
          <span class="font-display text-2xl leading-[30px] font-bold tracking-[-0.015em] sm:text-[26px] sm:leading-8" id="headline"></span>
          <span class:list={[lab, 'num']} id="subline"></span>
        </div>
        <div id="pays" class="flex flex-col rounded-2xl bg-raised px-3 py-0.5 sm:px-3.5"></div>
        <div id="balances" class="flex flex-col gap-2">
          <span class="ov text-[11px]">Balances</span>
          <div id="balance-rows" class="flex flex-col gap-2"></div>
        </div>
      </div>

      <div class={panel} data-reveal style="--i:1">
        <div class="flex items-center gap-3"><span class={step}>3</span><h2 class={h2}>Share the summary</h2></div>

        <div class="flex flex-col gap-4 rounded-3xl bg-[#F4F6F5] px-3.5 pt-5 pb-3.5 text-[#111614] sm:px-5 sm:pb-5">
          <div class="flex flex-col gap-0.5">
            <span class="font-display text-2xl leading-7 font-bold tracking-[-0.02em]">Split summary</span>
            <span class="text-sm font-medium text-[#56615C] [overflow-wrap:anywhere]" id="sum-meta"></span>
          </div>
          <div class="flex flex-col gap-3.5 rounded-card bg-white p-3.5 shadow-[0_8px_24px_#1116140F,0_1px_3px_#1116140D] sm:p-4">
            <div class="grid grid-cols-3 gap-2">
              <div class="flex min-w-0 flex-col gap-0.5 rounded-xl bg-[#EEF1F0] px-2.5 py-2.5"><span class="text-[11px] font-medium text-[#56615C]">Total</span><span class="num truncate text-[15px] font-bold" id="sum-total"></span></div>
              <div class="flex min-w-0 flex-col gap-0.5 rounded-xl bg-[#EEF1F0] px-2.5 py-2.5"><span class="text-[11px] font-medium text-[#56615C]">Expenses</span><span class="num text-[15px] font-bold" id="sum-count"></span></div>
              <div class="flex min-w-0 flex-col gap-0.5 rounded-xl bg-[#EEF1F0] px-2.5 py-2.5"><span class="text-[11px] font-medium text-[#56615C]">People</span><span class="num text-[15px] font-bold" id="sum-people"></span></div>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-[10px] leading-[14px] font-bold tracking-[0.08em] text-[#5F6A65]">WHO PAID</span>
              <div class="flex flex-wrap gap-1.5" id="sum-paid"></div>
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] leading-[14px] font-bold tracking-[0.08em] text-[#5F6A65]">WHO PAYS WHOM</span>
              <div class="flex flex-col" id="sum-pays"></div>
            </div>
          </div>
          <div class="flex items-center gap-3 rounded-2xl bg-[#087A62] px-4 py-3">
            <span class="flex min-w-0 flex-1 flex-col gap-px">
              <span class="font-display text-lg leading-[22px] font-bold text-white">PennyLog</span>
              <span class="text-xs font-medium text-[#DCF4EC]">Track shared expenses. Free on Google Play.</span>
            </span>
            <span class="text-[11px] font-medium whitespace-nowrap text-[#DCF4EC]" id="sum-today"></span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <button id="share" class="btn btn-p px-3" type="button" data-action="share"><Icon name="share" size={18} />Share</button>
          <button id="copy" class="btn btn-o px-3" type="button" data-action="copy"><Icon name="copy" size={18} />Copy text</button>
        </div>
        <p class:list={[lab, 'm-0 min-h-[18px] text-brand']} role="status" id="note"></p>
        <div id="text-wrap" class="flex flex-col gap-1.5" hidden>
          <label class={lab} for="sum-text">Summary text</label>
          <textarea id="sum-text" readonly class="min-h-[180px] w-full resize-y rounded-xl border border-line-strong bg-raised px-3.5 py-3 text-[13px] leading-5 text-ink"></textarea>
        </div>
      </div>
    </div>

    <!-- Phones: live result pinned to the bottom while the result panel is off screen -->
    <div
      data-result-bar
      class="pointer-events-none fixed inset-x-3 bottom-3 z-30 translate-y-[140%] opacity-0 transition-[transform,opacity] duration-300 ease-out lg:hidden data-show:pointer-events-auto data-show:translate-y-0 data-show:opacity-100"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <button
        type="button"
        data-action="to-result"
        class="flex w-full items-center gap-3 rounded-card border border-line-strong bg-overlay p-3 pl-4 text-left text-ink shadow-overlay"
      >
        <span class="flex min-w-0 flex-1 flex-col">
          <span class="truncate text-[15px] font-semibold" id="bar-headline"></span>
          <span class="num truncate text-[13px] text-muted" id="bar-sub"></span>
        </span>
        <span class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-xl bg-brand px-3.5 text-sm font-semibold text-on-brand">See who pays<Icon name="arrow" size={16} /></span>
      </button>
    </div>
  </section>

  <HikeStory />

  <section class="border-y border-line bg-surface">
    <div class="wrap flex flex-col gap-8 py-20">
      <div class="flex max-w-[640px] flex-col gap-3" data-reveal>
        <span class="ov">In the app</span>
        <h2 class="m-0 font-display text-[clamp(28px,3.4vw,40px)] leading-[1.1] font-bold tracking-[-0.025em] text-balance">The app does the same, and remembers it.</h2>
      </div>
      <ul class="-mx-4 m-0 flex list-none snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pt-2 pb-4 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:justify-center md:gap-10 md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden">
        {
          appShots.map((s, i) => (
            <li class="flex w-[58vw] max-w-[220px] shrink-0 snap-start flex-col gap-3" data-reveal style={`--i:${i}`}>
              <PhoneShot screen={s.screen} alt={s.alt} sizes="(min-width: 640px) 220px, 58vw" />
              <p class="m-0 px-1 text-sm leading-[21px] text-muted"><strong class="font-semibold text-ink">{s.title}.</strong> {s.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(250px,100%),1fr))] gap-3">
        {
          inApp.map(([t, b], i) => (
            <div class="card bg-bg p-5" data-reveal style={`--i:${i}`}>
              <h3 class="m-0 text-[17px] leading-6 font-semibold">{t}</h3>
              <p class="m-0 text-[15px] leading-[23px] text-muted">{b}</p>
            </div>
          ))
        }
      </div>
      <div data-reveal><PlayButton size="lg" class="max-sm:w-full" /></div>
    </div>
  </section>

  <!-- How it works + use cases: plain-text explanation for people (and search engines) landing here -->
  <section class="wrap flex flex-col gap-14 py-24">
    <div class="flex flex-wrap gap-x-16 gap-y-8">
      <div class="flex max-w-[420px] min-w-0 flex-[1_1_300px] flex-col gap-3" data-reveal="left">
        <span class="ov">How it works</span>
        <h2 class="m-0 font-display text-[clamp(28px,3.4vw,40px)] leading-[1.1] font-bold tracking-[-0.025em] text-balance">How to split expenses with friends.</h2>
        <p class="lead">A bill splitter only needs three things: who was there, what each person paid, and a fair way to settle up.</p>
      </div>
      <ol class="m-0 flex min-w-0 flex-[2_1_480px] list-none flex-col gap-3 p-0">
        {
          howTo.map(([t, b], i) => (
            <li class="card flex-row items-start gap-4" data-reveal style={`--i:${i}`}>
              <span class={step}>{i + 1}</span>
              <div class="flex flex-col gap-1">
                <h3 class="m-0 text-[17px] leading-6 font-semibold">{t}</h3>
                <p class="m-0 text-[15px] leading-[23px] text-muted">{b}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="flex flex-col gap-6">
      <h2 class="m-0 font-display text-[clamp(24px,2.6vw,30px)] leading-[1.15] font-bold tracking-[-0.02em]" data-reveal>Split bills for any group.</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(250px,100%),1fr))] gap-3">
        {
          useCases.map((u, i) => (
            <div class="card" data-reveal style={`--i:${i}`}>
              <span class:list={['tile', u.tile]}><Icon name={u.icon} /></span>
              <h3 class="mt-1 text-[17px] leading-6 font-semibold">{u.title}</h3>
              <p class="m-0 text-[15px] leading-[23px] text-muted">{u.body}</p>
            </div>
          ))
        }
      </div>
      <p class="m-0 max-w-[680px] text-[15px] leading-6 text-muted" data-reveal>
        Want to keep the group for later, split a cost among only some people, or pay back with a UPI QR? That is what
        the{' '}<a href="/features">PennyLog app</a> adds. More answers are in the <a href="/faq">FAQ</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { initSplit } from '../scripts/split';
  initSplit();
</script>
