---
// Scroll story for split sub-groups: four friends on a hike, two race ahead, each pair buys its own food.
// Numbers checked against the settle-up maths: equal split is ₹490 each; with sub-groups Aarav and Diya
// pay ₹620, Kabir and Meera ₹360, settled by Kabir → Aarav ₹360, Meera → Aarav ₹220, Meera → Diya ₹20.
// Artwork lives in src/assets/hike/ (see docs/hike-story.md); positions below are in the scene's 400×300 viewBox,
// i.e. the 1600×1200 art scaled by 1/4.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import PlayButton from './PlayButton.astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hike/**/*.png', { eager: true });
const art = async (path: string) => {
  const img = files[`../assets/hike/${path}.png`].default;
  return (await getImage({ src: img, format: 'webp', width: img.width })).src;
};

const layers = await Promise.all(['sky', 'mountains-far', 'hills-near', 'mountain-main', 'ground'].map((n) => art(`scene/hike-${n}`)));
const sun = await art('ambient/hike-sun');
const clouds = await Promise.all([1, 2, 3].map((n) => art(`ambient/hike-cloud-${n}`)));
const birdUp = await art('ambient/hike-bird-up');
const birdDown = await art('ambient/hike-bird-down');

// Props: placed by their base anchor (bottom-centre of the drawing) at scale s.
const propDefs = [
  { file: 'flag', w: 120, h: 220, ax: 60, ay: 212, s: 0.12, x: 281, y: 75 },
  { file: 'cafe', w: 320, h: 280, ax: 160, ay: 272, s: 0.14, x: 328, y: 75.5 },
  { file: 'chai-stall', w: 300, h: 260, ax: 150, ay: 252, s: 0.12, x: 226, y: 178 },
  { file: 'trail-sign', w: 160, h: 220, ax: 80, ay: 212, s: 0.12, x: 12, y: 273 },
];
const props = await Promise.all(
  propDefs.map(async (p) => ({
    ...p,
    href: await art(`props/hike-${p.file === 'cafe' ? 'summit-cafe' : p.file === 'flag' ? 'summit-flag' : p.file}`),
  })),
);
const cab = { href: await art('props/hike-cab'), s: 0.15, x: 124, y: 274 };

// Hiker sprites: 256×384 with feet at (128, 372); drawn 48 units tall.
const HS = 48 / 384;
const sprite = { w: 256 * HS, h: 384 * HS, x: -128 * HS, y: -372 * HS };
const poses = ['idle', 'walk-1', 'walk-2', 'eat', 'react', 'happy'] as const;

const people = [
  { id: 'a', file: 'aarav', name: 'Aarav', x: 30, bx: -9, eq: '₹490', fair: '₹620', over: false, av: 'bg-cat-sky/16 text-cat-sky' },
  { id: 'd', file: 'diya', name: 'Diya', x: 44, bx: 9, eq: '₹490', fair: '₹620', over: false, av: 'bg-cat-pink/16 text-cat-pink' },
  { id: 'k', file: 'kabir', name: 'Kabir', x: 58, bx: -8, eq: '₹490', fair: '₹360', over: true, av: 'bg-cat-lime/16 text-cat-lime' },
  { id: 'm', file: 'meera', name: 'Meera', x: 72, bx: 8, eq: '₹490', fair: '₹360', over: true, av: 'bg-cat-orange/16 text-cat-orange' },
];
const hikers = await Promise.all(
  people.map(async (p) => ({
    ...p,
    sprites: await Promise.all(poses.map(async (pose) => ({ pose, href: await art(`hikers/hike-${p.file}-${pose}`) }))),
  })),
);
const byId = Object.fromEntries(hikers.map((h) => [h.id, h]));

type Chapter = {
  time: string;
  title: string;
  body: string;
  cost?: { label: string; amount: string; who: string; paid: string; tag: string };
  kind?: 'equal' | 'fair';
};

const chapters: Chapter[] = [
  {
    time: '6:30 am · Trailhead',
    title: 'Four friends, one cab.',
    body: 'Aarav books a cab to the start of the trail. All four ride in it, so all four share it.',
    cost: { label: 'Cab to the trail', amount: '₹1,200', who: 'Shared by everyone', paid: 'Aarav paid', tag: 'bg-raised text-muted' },
  },
  {
    time: '8:00 am · On the trail',
    title: 'Two of them race ahead.',
    body: 'Aarav and Diya keep climbing to the top. Kabir and Meera take it slow and stop at the halfway point.',
  },
  {
    time: '10:15 am · Summit café',
    title: 'A proper meal at the top.',
    body: 'Aarav and Diya order thalis at the summit café. Only the two of them eat.',
    cost: { label: 'Summit café', amount: '₹640', who: 'Aarav and Diya only', paid: 'Diya paid', tag: 'bg-cat-violet/16 text-cat-violet' },
  },
  {
    time: '10:40 am · Halfway',
    title: 'Chai and biscuits.',
    body: 'Kabir and Meera stop for chai at a little stall halfway up.',
    cost: { label: 'Chai stall', amount: '₹120', who: 'Kabir and Meera only', paid: 'Meera paid', tag: 'bg-cat-yellow/16 text-cat-yellow' },
  },
  {
    time: 'Evening · Back home',
    title: 'Split equally, it isn’t fair.',
    body: 'Add up the day, ₹1,960, and divide by four: ₹490 each. Kabir and Meera each pay ₹130 towards a café meal they never ate. That is what an equal split, like the tool above, does.',
    kind: 'equal',
  },
  {
    time: 'In the PennyLog app',
    title: 'Sub-groups split it the way the day went.',
    body: 'Make a “Summit” sub-group for Aarav and Diya and a “Halfway” one for Kabir and Meera. The cab stays shared by all four.',
    kind: 'fair',
  },
];

const fairPays = [
  { from: 'k', to: 'a', amount: '₹360' },
  { from: 'm', to: 'a', amount: '₹220' },
  { from: 'm', to: 'd', amount: '₹20' },
];

const appSteps = [
  ['Create a sub-group', 'Open the group, tap New sub-group, call it “Summit” and pick Aarav and Diya.'],
  ['Add the sub-group expense', 'Inside the sub-group, add the ₹640 café meal. Only those two share it.'],
  ['Settle up once', 'Shared and sub-group costs are combined, so each person pays once.'],
];

const sans = 'font-family:var(--font-sans)';
---

<section class="wrap flex flex-col gap-8 pb-24" data-hike aria-labelledby="hike-title">
  <div class="flex max-w-[760px] flex-col gap-4" data-reveal>
    <span class="ov">When the group splits up</span>
    <h2 id="hike-title" class="h2">Not every cost is for everyone.</h2>
    <p class="lead">
      The tool above splits every expense equally among everyone. That works for a dinner, but real days are messier. Scroll through one
      hike to see why the app has <strong class="font-semibold text-ink">sub-groups</strong>.
    </p>
  </div>

  <div class="flex flex-col gap-6 lg:grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12">
    <!-- Illustration: pinned while the chapters scroll -->
    <div class="sticky top-[69px] z-10 -mx-4 bg-bg px-4 pt-2 pb-3 sm:-mx-6 sm:px-6 md:top-[84px] lg:top-24 lg:mx-0 lg:self-start lg:bg-transparent lg:p-0">
      <figure class="m-0 mx-auto flex w-full max-w-[min(100%,calc(44vh*4/3))] flex-col gap-2 lg:max-w-none">
        <div class="relative overflow-hidden rounded-sheet border border-line bg-[#96CEEC] shadow-overlay">
          <svg class="scene block h-auto w-full" viewBox="0 0 400 300" role="img" aria-labelledby="scene-title" data-step="1">
            <title id="scene-title">Four friends on a sunny day hike: two reach the summit café, two stop at a halfway chai stall.</title>

            <!-- Sky with sun, clouds and birds behind the mountains -->
            <image href={layers[0]} width="400" height="300" preserveAspectRatio="none"></image>
            <g class="sun"><image href={sun} x="47" y="52" width="46" height="46"></image></g>
            <g class="cloud cloud-1"><image href={clouds[0]} x="96" y="30" width="86" height="36"></image></g>
            <g class="cloud cloud-2"><image href={clouds[1]} x="228" y="14" width="58" height="26"></image></g>
            <g class="cloud cloud-3"><image href={clouds[2]} x="166" y="62" width="45" height="19"></image></g>
            <g class="birds">
              {[[150, 76], [166, 68]].map(([x, y], i) => (
                <g class="bird" style={`animation-delay:${i * -0.2}s`}>
                  <image class="wing-up" href={birdUp} x={x} y={y} width="12" height="8" />
                  <image class="wing-down" href={birdDown} x={x} y={y} width="12" height="8" />
                </g>
              ))}
            </g>
            <image href={layers[1]} width="400" height="300"></image>
            <image href={layers[2]} width="400" height="300"></image>
            <image href={layers[3]} width="400" height="300"></image>
            <image href={layers[4]} width="400" height="300"></image>

            <!-- Places -->
            <circle class="spot spot-cafe" cx="328" cy="62" r="20" fill="none" stroke="#B79CFF" stroke-width="1.5"></circle>
            <circle class="spot spot-chai" cx="226" cy="164" r="18" fill="none" stroke="#EBD25A" stroke-width="1.5"></circle>
            {props.map((p) => (
              <image class:list={['prop', `prop-${p.file}`]} href={p.href} x={p.x - p.ax * p.s} y={p.y - p.ay * p.s} width={p.w * p.s} height={p.h * p.s} />
            ))}
            <g class="steam steam-cafe" fill="none" stroke="#5F6A65" stroke-width="1.1" stroke-linecap="round">
              <path d="M333 34 q-2 -3 0 -6"></path><path d="M336 35 q2 -3 0 -6"></path>
            </g>
            <g class="steam steam-chai" fill="none" stroke="#5F6A65" stroke-width="1" stroke-linecap="round">
              <path d="M226 152 q-2 -3 0 -6"></path><path d="M229 153 q2 -3 0 -6"></path>
            </g>

            <!-- Cab -->
            <g transform={`translate(${cab.x - 200 * cab.s} ${cab.y - 192 * cab.s})`}>
              <g class="cab"><image href={cab.href} width={400 * cab.s} height={200 * cab.s}></image></g>
            </g>

            <!-- Cost chips (under the hikers, so walkers pass in front) -->
            <g transform="translate(100 206)">
              <g class="pop chip-cab">
                <rect width="76" height="30" rx="8" fill="#FFFFFF"></rect>
                <text x="8" y="11" font-size="7" font-weight="500" fill="#56615C" style={sans}>Cab · everyone</text>
                <text x="8" y="23.5" font-size="11.5" font-weight="700" fill="#111614" style={sans}>₹1,200</text>
              </g>
            </g>
            <g transform="translate(192 22)">
              <g class="pop chip-cafe">
                <rect width="78" height="30" rx="8" fill="#FFFFFF"></rect>
                <text x="8" y="11" font-size="7" font-weight="500" fill="#56615C" style={sans}>Café · 2 people</text>
                <text x="8" y="23.5" font-size="11.5" font-weight="700" fill="#111614" style={sans}>₹640</text>
              </g>
            </g>
            <g transform="translate(246 184)">
              <g class="pop chip-chai">
                <rect width="76" height="30" rx="8" fill="#FFFFFF"></rect>
                <text x="8" y="11" font-size="7" font-weight="500" fill="#56615C" style={sans}>Chai · 2 people</text>
                <text x="8" y="23.5" font-size="11.5" font-weight="700" fill="#111614" style={sans}>₹120</text>
              </g>
            </g>

            <!-- Sub-group rings (last chapter) -->
            <g class="ring ring-summit">
              <ellipse cx="301" cy="52" rx="23" ry="29" fill="#B79CFF" fill-opacity="0.14" stroke="#B79CFF" stroke-width="1.6"></ellipse>
              <rect x="277" y="85" width="48" height="14" rx="7" fill="#B79CFF"></rect>
              <text x="301" y="92.5" font-size="7.5" font-weight="700" fill="#14181B" text-anchor="middle" dominant-baseline="middle" style={sans}>Summit</text>
            </g>
            <g class="ring ring-halfway">
              <ellipse cx="197.5" cy="166" rx="24" ry="29" fill="#EBD25A" fill-opacity="0.14" stroke="#EBD25A" stroke-width="1.6"></ellipse>
              <rect x="171.5" y="199" width="52" height="14" rx="7" fill="#EBD25A"></rect>
              <text x="197.5" y="206.5" font-size="7.5" font-weight="700" fill="#14181B" text-anchor="middle" dominant-baseline="middle" style={sans}>Halfway</text>
            </g>

            <!-- Hikers: walked and posed by the script; badges show each person's share -->
            {hikers.map((h) => (
              <g class:list={['hiker', h.over && 'over']} data-hiker={h.id} data-pose="idle" style={`transform: translate(${h.x}px, 273px)`}>
                <ellipse cx="0" cy="0.5" rx="6.5" ry="1.7" fill="#000" opacity="0.3" />
                <g class="body">
                  {h.sprites.map((s) => (
                    <image class:list={['pose', `p-${s.pose}`]} href={s.href} x={sprite.x} y={sprite.y} width={sprite.w} height={sprite.h} />
                  ))}
                </g>
                <g transform={`translate(${h.bx} -53)`}>
                  <g class="badge">
                    <rect x="-14" y="-7.5" width="28" height="15" rx="7.5" />
                    <text class="amt-eq" x="0" y="0.5" font-size="8.5" font-weight="700" fill="#111614" text-anchor="middle" dominant-baseline="middle" style={sans}>{h.eq}</text>
                    <text class="amt-fair" x="0" y="0.5" font-size="8.5" font-weight="700" fill="#111614" text-anchor="middle" dominant-baseline="middle" style={sans}>{h.fair}</text>
                  </g>
                </g>
              </g>
            ))}

            <!-- Verdict pills -->
            <g transform="translate(96 104)">
              <g class="verdict verdict-equal">
                <rect width="132" height="22" rx="11" fill="#FF8070"></rect>
                <text x="66" y="11.5" font-size="8.5" font-weight="700" fill="#2A0C08" text-anchor="middle" dominant-baseline="middle" style={sans}>₹1,960 ÷ 4 = ₹490 each</text>
              </g>
              <g class="verdict verdict-fair">
                <rect width="132" height="22" rx="11" fill="#34D3A6"></rect>
                <text x="66" y="11.5" font-size="8.5" font-weight="700" fill="#052A20" text-anchor="middle" dominant-baseline="middle" style={sans}>3 payments settle everyone</text>
              </g>
            </g>
          </svg>
        </div>
        <figcaption class="flex items-center justify-between gap-3 px-1">
          <span class="truncate text-[13px] font-semibold text-muted" data-caption>{chapters[0].time}</span>
          <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            {chapters.map((_, i) => <span data-dot class:list={['h-1.5 rounded-full transition-all duration-500', i === 0 ? 'w-5 bg-brand' : 'w-1.5 bg-line-strong']} />)}
          </span>
        </figcaption>
      </figure>
    </div>

    <!-- Chapters -->
    <ol class="m-0 flex list-none flex-col p-0">
      {
        chapters.map((c, i) => (
          <li
            data-chapter
            class:list={[
              'flex min-h-[62vh] items-center py-6 transition-opacity duration-500 lg:min-h-[78vh]',
              i === 0 && 'pt-2 lg:pt-6',
              i === chapters.length - 1 && 'min-h-0 lg:min-h-[60vh]',
            ]}
          >
            <article class="flex w-full flex-col gap-3 rounded-sheet border border-line bg-surface p-5 sm:p-6">
              <span class="text-[13px] font-semibold text-brand">{c.time}</span>
              <h3 class="m-0 font-display text-[clamp(22px,2.6vw,30px)] leading-[1.15] font-bold tracking-[-0.02em] text-balance">{c.title}</h3>
              <p class="m-0 text-base leading-[25px] text-pretty text-muted">{c.body}</p>

              {c.cost && (
                <div class="mt-1 flex items-center gap-3 rounded-card bg-raised p-3.5">
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                    <span class="text-[15px] font-semibold">{c.cost.label}</span>
                    <span class="text-[13px] text-muted">{c.cost.paid}</span>
                  </span>
                  <span class="flex flex-col items-end gap-1">
                    <span class="num text-lg font-semibold">{c.cost.amount}</span>
                    <span class:list={['rounded-lg px-2 py-0.5 text-xs font-semibold whitespace-nowrap', c.cost.tag]}>{c.cost.who}</span>
                  </span>
                </div>
              )}

              {c.kind && (
                <div class="mt-1 overflow-hidden rounded-card bg-raised">
                  {hikers.map((h, j) => (
                    <div class:list={['flex items-center gap-2.5 px-3.5 py-2.5', j > 0 && 'border-t border-line']}>
                      <span class:list={['av size-7 text-xs', h.av]}>{h.name[0]}</span>
                      <span class="min-w-0 flex-1 text-[15px] font-semibold">{h.name}</span>
                      {c.kind === 'equal' ? (
                        <span class:list={['num text-[15px] font-semibold', h.over ? 'text-expense' : 'text-muted']}>
                          {h.eq}
                          {h.over && <span class="ml-1.5 rounded-md bg-expense-soft px-1.5 py-0.5 text-xs">+₹130</span>}
                        </span>
                      ) : (
                        <span class="num text-[15px] font-semibold text-brand">
                          {h.over && <span class="mr-1.5 text-xs text-subtle line-through">{h.eq}</span>}
                          {h.fair}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {c.kind === 'fair' && (
                <div class="flex flex-col rounded-card border border-line px-3.5">
                  {fairPays.map((p, j) => (
                    <div class:list={['flex items-center gap-2 py-2.5', j > 0 && 'border-t border-line']}>
                      <span class:list={['av size-7 text-xs', byId[p.from].av]}>{byId[p.from].name[0]}</span>
                      <Icon name="arrow" size={14} class="text-subtle" />
                      <span class:list={['av size-7 text-xs', byId[p.to].av]}>{byId[p.to].name[0]}</span>
                      <span class="min-w-0 flex-1 text-sm font-semibold">{byId[p.from].name} pays {byId[p.to].name}</span>
                      <span class="num text-[15px] font-semibold">{p.amount}</span>
                    </div>
                  ))}
                </div>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- How to do it in the app -->
  <div class="flex flex-col gap-5 rounded-sheet bg-brand-soft p-5 sm:p-8" data-reveal="scale">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-2">
        <span class="text-sm font-semibold text-brand">Sub-groups · in the PennyLog app</span>
        <h3 class="m-0 font-display text-[clamp(24px,3vw,32px)] leading-[1.15] font-bold tracking-[-0.02em] text-ink">Split it the way the day actually went.</h3>
      </div>
      <PlayButton class="max-sm:w-full" />
    </div>
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-3 p-0">
      {
        appSteps.map(([title, body], i) => (
          <li class="flex gap-3 rounded-card bg-surface p-4" data-reveal style={`--i:${i}`}>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-on-brand">{i + 1}</span>
            <span class="flex flex-col gap-1">
              <span class="text-base leading-[22px] font-semibold">{title}</span>
              <span class="text-sm leading-[21px] text-muted">{body}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* ---- ambient motion ---- */
  .sun { animation: glow 4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .cloud-1 { animation: drift 14s ease-in-out infinite alternate; }
  .cloud-2 { animation: drift 18s ease-in-out -6s infinite alternate-reverse; }
  .cloud-3 { animation: drift 22s ease-in-out -3s infinite alternate; }
  .birds { animation: glide 18s linear infinite; }
  .bird .wing-down { opacity: 0; }
  .bird .wing-up { animation: flap-a 0.5s steps(1, end) infinite; }
  .bird .wing-down { animation: flap-b 0.5s steps(1, end) infinite; }
  .prop-flag { transform-box: fill-box; transform-origin: 30% 100%; animation: sway 2.4s ease-in-out infinite; }
  @keyframes glow { 50% { transform: scale(1.08); opacity: 0.92; } }
  @keyframes drift { to { transform: translateX(30px); } }
  @keyframes glide { from { transform: translate(-60px, 8px); } to { transform: translate(280px, -20px); } }
  @keyframes flap-a { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes flap-b { 0% { opacity: 0; } 50% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes sway { 50% { transform: rotate(2deg); } }

  /* ---- hikers: one sprite visible at a time ---- */
  .pose { opacity: 0; transition: opacity 0.25s ease; }
  .hiker[data-pose='idle'] .p-idle,
  .hiker[data-pose='eat'] .p-eat,
  .hiker[data-pose='react'] .p-react,
  .hiker[data-pose='happy'] .p-happy { opacity: 1; }
  /* walking alternates the two stride frames */
  .hiker.walking .pose:not(.p-walk-1):not(.p-walk-2) { opacity: 0; transition: none; }
  .hiker.walking .p-walk-1 { transition: none; animation: flap-a 0.38s steps(1, end) infinite; }
  .hiker.walking .p-walk-2 { transition: none; animation: flap-b 0.38s steps(1, end) infinite; }
  .body { transform-box: fill-box; transform-origin: center bottom; }
  .hiker.downhill .body { transform: scaleX(-1); }
  /* chapter 5: the two who overpay shake their heads; chapter 6: everyone hops */
  .scene[data-step='5'] .over .body { animation: shake 0.5s ease-in-out 0.3s 2; }
  .scene[data-step='6'] .hiker .body { animation: hop 0.55s cubic-bezier(0.3, 0, 0.3, 1) 2; }
  .scene[data-step='6'] [data-hiker='d'] .body { animation-delay: 0.1s; }
  .scene[data-step='6'] [data-hiker='k'] .body { animation-delay: 0.2s; }
  .scene[data-step='6'] [data-hiker='m'] .body { animation-delay: 0.3s; }
  @keyframes shake { 25% { transform: rotate(-4deg); } 75% { transform: rotate(4deg); } }
  @keyframes hop { 40% { transform: translateY(-6px); } }

  /* ---- cab: drives in when the scene appears, drives off when the hike starts ---- */
  .cab { transition: transform 1.6s cubic-bezier(0.45, 0, 0.2, 1); }
  .scene.armed .cab { transform: translateX(-180px); }
  .scene.armed.inview .cab { transform: none; }
  .scene.armed.ge2 .cab { transform: translateX(340px); }

  /* ---- things that appear as the story goes ---- */
  .pop, .badge, .verdict, .ring {
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .scene.armed .pop, .scene.armed .badge, .scene.armed .verdict, .scene.armed .ring { opacity: 0; transform: scale(0.4); }
  .scene.armed.inview .chip-cab,
  .scene.armed.ge3 .chip-cafe,
  .scene.armed.ge4 .chip-chai,
  .scene.armed.ge5 .badge,
  .scene.armed.ge6 .ring { opacity: 1; transform: none; }
  .scene.armed[data-step='5'] .verdict-equal,
  .scene.armed[data-step='6'] .verdict-fair { opacity: 1; transform: none; }

  .badge rect { fill: #ffffff; transition: fill 0.4s; }
  /* white cards need a lift against the daytime sky */
  .pop, .badge, .verdict { filter: drop-shadow(0 1.5px 2px rgb(17 22 20 / 0.22)); }
  .scene[data-step='5'] .over .badge rect { fill: #ff8070; }
  .scene.ge6 .badge rect { fill: #34d3a6; }
  .amt-eq, .amt-fair { transition: opacity 0.3s; }
  .amt-fair { opacity: 0; }
  .scene.ge6 .amt-eq { opacity: 0; }
  .scene.ge6 .amt-fair { opacity: 1; }
  .ring ellipse { stroke-dasharray: 4 3; animation: march 1.4s linear infinite; }
  @keyframes march { to { stroke-dashoffset: -14; } }

  /* places light up in their chapter */
  .spot { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .scene[data-step='3'] .spot-cafe, .scene[data-step='4'] .spot-chai { animation: pulse 1.6s ease-out infinite; }
  @keyframes pulse { 0% { opacity: 0.9; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.5); } }
  .steam path { opacity: 0; }
  .scene.ge3 .steam-cafe path, .scene.ge4 .steam-chai path { animation: steam 2.2s ease-out infinite; }
  .steam path:nth-child(2) { animation-delay: 1.1s !important; }
  @keyframes steam { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 0.85; } 100% { opacity: 0; transform: translateY(-9px); } }

  /* the chapter being read stays bright */
  [data-chapter] { opacity: 0.4; }
  [data-chapter][data-active] { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .cloud, .birds, .bird *, .prop-flag, .sun, .ring ellipse, .body { animation: none !important; }
    [data-chapter] { opacity: 1; }
  }
</style>

<script>
  type Pt = [number, number];
  // The painted trail (viewBox units), from the trailhead to the summit plateau.
  const TRAIL: Pt[] = [[87.5, 272.5], [125, 247.5], [155, 225], [175, 205], [192.5, 188.75], [211.25, 186.25], [230, 162.5], [250, 142.5], [270, 120], [292.5, 87.5]];
  const starts: Record<string, Pt> = { a: [30, 273], d: [44, 273], k: [58, 273], m: [72, 273] };
  // Where each hiker ends up: the summit pair on the plateau by the café, the other pair on the halfway ledge.
  const routes: Record<string, Pt[]> = {
    a: [starts.a, ...TRAIL, [295, 75]],
    d: [starts.d, ...TRAIL, [307, 75]],
    k: [starts.k, ...TRAIL.slice(0, 4), [190, 189.5]],
    m: [starts.m, ...TRAIL.slice(0, 5), [205, 187]],
  };
  // They set off in single file, a moment apart, once the cab has pulled away.
  const order = ['a', 'd', 'k', 'm'];
  const GAP = 320;
  const LEAD = 450;
  const SPEED = 130; // viewBox units per second

  // Pose for each hiker in each chapter (1-based); walking overrides this while moving.
  const poseFor = (id: string, step: number) => {
    if (step >= 6) return 'happy';
    if (step === 5) return 'react';
    if (step >= 3 && (id === 'a' || id === 'd')) return 'eat';
    if (step === 4 && (id === 'k' || id === 'm')) return 'eat';
    return 'idle';
  };

  const root = document.querySelector<HTMLElement>('[data-hike]');
  if (root) {
    const scene = root.querySelector<SVGSVGElement>('svg.scene')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const times = chapters.map((c) => c.querySelector('span')?.textContent ?? '');
    const hikers = [...scene.querySelectorAll<SVGGElement>('[data-hiker]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const running = new Map<SVGGElement, Animation>();
    const timers = new Map<SVGGElement, number>();
    const at = (p: Pt) => `translate(${p[0]}px, ${p[1]}px)`;

    scene.classList.add('armed');
    let step = 0;
    let where: 'base' | 'split' = 'base';

    const setPoses = () => hikers.forEach((el) => (el.dataset.pose = poseFor(el.dataset.hiker!, step)));

    // Walk every hiker along the trail (or back down it) at an even pace, in single file.
    const walk = (to: 'base' | 'split') => {
      for (const el of hikers) {
        const id = el.dataset.hiker!;
        const route = routes[id];
        const pts = to === 'split' ? route : [...route].reverse();
        running.get(el)?.finish();
        clearTimeout(timers.get(el));
        const seg = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
        const total = seg.reduce((a, b) => a + b, 0);
        let run = 0;
        const frames = pts.map((p, i) => {
          if (i > 0) run += seg[i - 1];
          return { transform: at(p), offset: total ? run / total : i / (pts.length - 1) };
        });
        const rank = to === 'split' ? order.indexOf(id) : order.length - 1 - order.indexOf(id);
        const anim = el.animate(frames, {
          duration: reduced ? 0 : Math.max(900, (total / SPEED) * 1000),
          delay: reduced ? 0 : (to === 'split' ? LEAD : 0) + rank * GAP,
          easing: 'ease-in-out',
          fill: 'backwards',
        });
        running.set(el, anim);
        // Stride frames only while actually moving; face downhill on the way back.
        const startWalking = () => {
          el.classList.add('walking');
          el.classList.toggle('downhill', to === 'base');
        };
        if (reduced) startWalking();
        else timers.set(el, window.setTimeout(startWalking, (to === 'split' ? LEAD : 0) + rank * GAP));
        anim.onfinish = () => {
          el.style.transform = at(pts[pts.length - 1]);
          clearTimeout(timers.get(el));
          el.classList.remove('walking', 'downhill');
          running.delete(el);
        };
      }
    };

    const setStep = (n: number) => {
      if (n === step) return;
      step = n;
      scene.dataset.step = String(n);
      for (let i = 1; i <= chapters.length; i++) scene.classList.toggle(`ge${i}`, n >= i);
      const want = n >= 2 ? 'split' : 'base';
      if (want !== where) {
        where = want;
        walk(want);
      }
      setPoses();
      chapters.forEach((c, i) => c.toggleAttribute('data-active', i === n - 1));
      dots.forEach((d, i) => {
        d.classList.toggle('w-5', i === n - 1);
        d.classList.toggle('bg-brand', i <= n - 1);
        d.classList.toggle('w-1.5', i !== n - 1);
        d.classList.toggle('bg-line-strong', i > n - 1);
      });
      caption.textContent = times[n - 1];
    };

    // The active chapter is the last one whose top has passed a reading line:
    // mid-screen on desktop, lower on phones where the scene is pinned above the text.
    const wide = matchMedia('(min-width: 1024px)');
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = innerHeight * (wide.matches ? 0.55 : 0.78);
      let n = 1;
      chapters.forEach((c, i) => {
        if (c.querySelector('article')!.getBoundingClientRect().top < line) n = i + 1;
      });
      setStep(n);
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    addEventListener('resize', update);

    // The cab drives in the first time the scene is on screen.
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) {
        scene.classList.add('inview');
        io.disconnect();
      }
    }, { threshold: 0.35 }).observe(scene);

    setStep(1);
    update();
  }
</script>
